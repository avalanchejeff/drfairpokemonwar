  great: "Great League",
  ultra: "Ultra League",
  master: "Master League",
};

function speciesLabel(id: string) {
  return id
    .toLowerCase()
    .split("_")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

function formLabel(record: WarRecord) {
  const species = speciesLabel(record.pokemonId);
  const display = record.displayName.trim();
  const remainder = display.toLowerCase().startsWith(species.toLowerCase())
    ? display.slice(species.length).trim()
    : display;
  return remainder || "Normal";
}

function pvpCandidates(record: WarRecord) {
  const slug = record.name.replaceAll("-", "_").toLowerCase();
  const base = record.pokemonId.toLowerCase();
  const form = record.form?.toLowerCase() ?? "";
  const candidates = new Set([slug, base]);

  if (form) {
    const suffix = form
      .replace(new RegExp(
        "^" + record.pokemonId.toLowerCase() + "_?"
      ), "")
      .replace(/^normal$/, "");
    if (suffix) candidates.add(base + "_" + suffix);
  }

  if (slug.startsWith("shadow_")) {
    candidates.add(slug.replace(/^shadow_(.+)$/, "$1_shadow"));
  }
  if (slug.endsWith("_shadow")) {
    candidates.add(slug.replace(/^(.+)_shadow$/, "shadow_$1"));
  }

  return [...candidates];
}

function findPvpEntry(record: WarRecord, league: LeagueKey) {
  const candidates = pvpCandidates(record);
  return (
    leagueData[league].find((entry) => candidates.includes(entry.speciesId)) ??
    null
  );
}

function moveLabel(id: string) {
  return id
    .toLowerCase()
    .split("_")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

const pending = <span className="text-zinc-500">Pending</span>;

export default function LabPage() {
  const speciesOptions = useMemo(
    () =>
      Array.from(new Set(records.map((record) => record.pokemonId))).sort(
        (a, b) => speciesLabel(a).localeCompare(speciesLabel(b))
      ),
    []
  );

  const [pokemonId, setPokemonId] = useState("");
  const [recordName, setRecordName] = useState("");
  const [cp, setCp] = useState("");
  const [attack, setAttack] = useState("15");
  const [defense, setDefense] = useState("15");
  const [hp, setHp] = useState("15");
  const [height, setHeight] = useState("");
  const [weight, setWeight] = useState("");
  const [isShiny, setIsShiny] = useState(false);
  const [maxType, setMaxType] = useState("Standard");
  const [fastMove, setFastMove] = useState("");
  const [chargedMove1, setChargedMove1] = useState("");
  const [chargedMove2, setChargedMove2] = useState("");

  const formOptions = useMemo(
    () => records.filter((record) => record.pokemonId === pokemonId),
    [pokemonId]
  );

  const selectedRecord = useMemo(
    () => records.find((record) => record.name === recordName) ?? null,
    [recordName]
  );

  const selectedMovePool = useMemo(() => {
    if (!selectedRecord) return null;

    const sameSpecies = movePools.filter(
      (pool) => pool.pokemonId === selectedRecord.pokemonId
    );

    const exactForm = sameSpecies.find(
      (pool) => pool.form === selectedRecord.form
    );
    if (exactForm) return exactForm;

    if (!selectedRecord.form) {
      return (
        sameSpecies.find(
          (pool) => pool.form === `${selectedRecord.pokemonId}_NORMAL`
        ) ??
        sameSpecies.find((pool) => pool.form === "NORMAL") ??
        sameSpecies.find((pool) => !pool.form) ??
        null
      );
    }

    return null;
  }, [selectedRecord]);

  useEffect(() => {
    const fastMoves = selectedMovePool?.fastMoves ?? [];
    const chargedMoves = selectedMovePool?.chargedMoves ?? [];

    setFastMove(
      fastMoves.find((move) => move.id === selectedRecord?.bestFastMove)?.id ??
        fastMoves[0]?.id ??
        ""
    );
    setChargedMove1(
      chargedMoves.find(
        (move) => move.id === selectedRecord?.bestChargedMove
      )?.id ??
        chargedMoves[0]?.id ??
        ""
    );
    setChargedMove2("");
  }, [selectedMovePool, selectedRecord]);

  function selectPokemon(id: string) {
    setPokemonId(id);
    const matches = records.filter((record) => record.pokemonId === id);
    const preferred =
      matches.find((record) => formLabel(record) === "Normal") ??
      matches[0] ??
      null;
    setRecordName(preferred?.name ?? "");
  }

  const sizeShowcase = useMemo(() => {
    if (!selectedRecord) return null;

    const exactKey = selectedRecord.pokemonId + ":" + (selectedRecord.form ?? "NORMAL");
    const normalKey = selectedRecord.pokemonId + ":NORMAL";
    const reference = sizeReferences[exactKey] ?? sizeReferences[normalKey];
    if (!reference) return null;

    const measuredHeight = Number(height);
    const measuredWeight = Number(weight);
    const hasHeight = Number.isFinite(measuredHeight) && measuredHeight > 0;
    const hasWeight = Number.isFinite(measuredWeight) && measuredWeight > 0;

    const heightPercentile = hasHeight && reference.heightStdDev > 0
      ? normalCdf((measuredHeight - reference.averageHeightM) / reference.heightStdDev) * 100
      : null;
    const weightPercentile = hasWeight && reference.weightStdDev > 0
      ? normalCdf((measuredWeight - reference.averageWeightKg) / reference.weightStdDev) * 100
      : null;

    const ivPercent = ((Number(attack) + Number(defense) + Number(hp)) / 45) * 100;
    const showcasePotential = heightPercentile !== null && weightPercentile !== null
      ? Math.min(100, heightPercentile * 0.8 + weightPercentile * 0.15 + ivPercent * 0.05)
      : null;

    const baseArtworkKey = selectedRecord.name.endsWith("-shadow")
      ? selectedRecord.name.replace(/-shadow$/, "")
      : selectedRecord.name;
    const artworkUrl =
      artworkIndexHD[selectedRecord.name as keyof typeof artworkIndexHD] ??
      artworkIndexHD[baseArtworkKey as keyof typeof artworkIndexHD] ??
      null;

    return {
      reference,
      heightPercentile,
      weightPercentile,
      showcasePotential,
      artworkUrl,
      scale: percentileScale(heightPercentile ?? 50),
    };
  }, [selectedRecord, height, weight, attack, defense, hp]);

  const maxBattleMeta = useMemo(() => {
    if (!selectedRecord || maxType === "Standard") return null;

    const base = selectedRecord.pokemonId;
    const form = selectedRecord.form ?? "";
    const name = selectedRecord.name.toUpperCase().replaceAll("-", "_");

    let candidates: string[] = [];

    if (maxType === "Gigantamax") {
      candidates = [
        `GIGANTAMAX_${base}`,
        form.startsWith("GIGANTAMAX_") ? form : "",
        name.startsWith("GIGANTAMAX_") ? name : "",
      ].filter(Boolean);
    } else {
      const specialKey =
        specialMaxRoleKeys[name] ??
        specialMaxRoleKeys[form] ??
        specialMaxRoleKeys[base] ??
        "";

      candidates = [
        specialKey,
        name,
        form,
        form.startsWith(base + "_")
          ? form.slice(base.length + 1) + "_" + base
          : "",
        base,
      ].filter(Boolean);
    }

    const roleKey = candidates.find((key) => maxBattleRoles[key]);
    if (!roleKey) return null;

    const role = maxBattleRoles[roleKey];
    const tiers = [
      { label: "Attacker", tier: role.attackerTier },
      { label: "Tank", tier: role.defenderTier },
      { label: "Healer", tier: role.healerTier },
    ].filter((item) => item.tier);

    tiers.sort(
      (a, b) =>
        (maxTierScore[b.tier ?? ""] ?? 0) -
        (maxTierScore[a.tier ?? ""] ?? 0)
    );

    const bestScore = tiers.length
      ? maxTierScore[tiers[0].tier ?? ""] ?? 0
      : 0;
    const bestRole = tiers
      .filter((item) => (maxTierScore[item.tier ?? ""] ?? 0) === bestScore)
      .map((item) => item.label)
      .join(" / ") || "Not rated";

    const selectedFastMove = selectedMovePool?.fastMoves.find(
      (move) => move.id === fastMove
    );
    const fastType =
      selectedFastMove?.type?.replace("POKEMON_TYPE_", "") ?? "";

    let recommendedAttack = "Not captured";
    if (role.specialAttack) {
      recommendedAttack = role.specialAttack;
    } else if (role.identity === "GIGANTAMAX") {
      recommendedAttack = "Species-specific G-Max Attack";
    } else if (fastType && maxAttackNames[fastType]) {
      recommendedAttack = maxAttackNames[fastType];
    }

    return {
      role,
      roleKey,
      bestRole,
      recommendedAttack,
      selectedFastMoveName: selectedFastMove?.name ?? null,
    };
  }, [selectedRecord, selectedMovePool, fastMove, maxType]);

  const raidMeta = useMemo(() => {
    if (!selectedRecord) return null;

    const entry = raidLabSummary[selectedRecord.name];
    if (!entry) return null;

    return {
      group: { type: entry.type },
      entry: { ...entry, raidRank: entry.typeRank },
      typePotential: entry.typePotential,
    };
  }, [selectedRecord]);

  const selectedRaidBuildMatches = useMemo(() => {
    if (!raidMeta) return false;
    return (
      fastMove === raidMeta.entry.bestFastMove &&
      (chargedMove1 === raidMeta.entry.bestChargedMove ||
        chargedMove2 === raidMeta.entry.bestChargedMove)
    );
  }, [raidMeta, fastMove, chargedMove1, chargedMove2]);

  const currentIVs = useMemo(
    () => ({
      atkIV: Number(attack),
      defIV: Number(defense),
      hpIV: Number(hp),
    }),
    [attack, defense, hp]
  );

  const pvpMeta = useMemo(() => {
    if (!selectedRecord) return null;

    const choices = (["great", "ultra", "master"] as LeagueKey[])
      .map((league) => {
        const entry = findPvpEntry(selectedRecord, league);
        if (!entry) return null;
        const rank =
          leagueData[league].findIndex(
            (candidate) => candidate.speciesId === entry.speciesId
          ) + 1;
        return { league, entry, rank };
      })
      .filter(Boolean) as { league: LeagueKey; entry: PvpEntry; rank: number }[];

    if (!choices.length) return null;
    choices.sort((a, b) => b.entry.score - a.entry.score || a.rank - b.rank);
    return choices[0];
  }, [selectedRecord]);

  const pvpIvResult = useMemo(() => {
    if (!selectedRecord || !pvpMeta) return null;
    if (![currentIVs.atkIV, currentIVs.defIV, currentIVs.hpIV].every(Number.isFinite)) {
      return null;
    }

    return rankPvpIvs({
      baseAttack: selectedRecord.attack,
      baseDefense: selectedRecord.defense,
      baseStamina: selectedRecord.stamina,
      league: pvpMeta.league,
      currentIVs,
    });
  }, [selectedRecord, pvpMeta, currentIVs]);

  const detectedLevels = useMemo(() => {
    if (!selectedRecord || !cp.trim()) return [];
    return detectLevelFromCp({
      baseAttack: selectedRecord.attack,
      baseDefense: selectedRecord.defense,
      baseStamina: selectedRecord.stamina,
      currentIVs,
      cp: Number(cp),
    });
  }, [selectedRecord, currentIVs, cp]);

  const detectedLevelText = !cp.trim()
    ? "--.-"
    : detectedLevels.length === 1
      ? detectedLevels[0].toFixed(1)
      : detectedLevels.length > 1
        ? detectedLevels.join(" / ")
        : "No match";

  const specimenValueText = pvpIvResult
    ? pvpIvResult.current.statProductPercent.toFixed(2) + "%"
    : "--.-%";

  const field =
    "w-full rounded-xl border border-zinc-700 bg-zinc-900 px-3 py-3 text-white outline-none focus:border-cyan-400";
  const label =
    "text-xs font-bold uppercase tracking-[0.18em] text-zinc-400";

  return (
    <main className="min-h-screen scroll-smooth bg-black">
      <div className="relative mx-auto h-screen w-fit">
        <img
          src="/lab/dr-fairs-lab.png"
          alt="Dr. Fair Lab"
          className="h-screen w-screen object-contain"
        />

        <div className="absolute left-[16%] top-[2%] w-[50%] rounded-2xl border-2 border-cyan-500 bg-white/95 px-3 py-2 text-[11px] font-semibold leading-snug text-zinc-900 shadow-xl md:text-sm">
          Welcome to my lab! If you want me to inspect your Pokémon, come over
          to the counter. If you want to compare Pokémon, let&apos;s go to the
          whiteboard.
        </div>

        <a
          href="#analyzer"
          aria-label="Inspect your Pokemon at the counter"
          title="Inspect your Pokemon"
          className="absolute bottom-[3%] left-[20%] h-[25%] w-[60%] cursor-pointer rounded-2xl border-2 border-transparent bg-cyan-400/0 transition hover:border-cyan-300/80 hover:bg-cyan-400/10"
        />
      </div>

      <section
        id="analyzer"
        className="min-h-screen bg-zinc-950 px-4 py-12 text-white"
      >
        <div className="mx-auto max-w-7xl">
          <header className="mb-8 text-center">
            <p className="text-sm font-bold uppercase tracking-[0.3em] text-cyan-400">
              Dr. Fair&apos;s Lab
            </p>
            <h2 className="mt-3 text-4xl font-black md:text-5xl">
              Pokémon Assessment
            </h2>
            <p className="mx-auto mt-3 max-w-2xl text-zinc-400">
              Enter the specimen details. Dr. Fair will evaluate the individual
              Pokémon, its meta value, and whether it is worth keeping or
              investing in.
            </p>
          </header>

          <section className="rounded-3xl border border-zinc-800 bg-zinc-900/70 p-5 md:p-6">
            <h3 className="text-2xl font-black">Specimen Details</h3>

            <div className="mt-5 grid gap-4 lg:grid-cols-2">
              <label className="flex items-center gap-3">
                <span className="w-20 shrink-0 text-sm font-bold text-zinc-300">
                  Pokémon
                </span>
                <select
                  className={field}
                  value={pokemonId}
                  onChange={(event) => selectPokemon(event.target.value)}
                >
                  <option value="">Select a Pokémon</option>
                  {speciesOptions.map((id) => (
                    <option key={id} value={id}>
                      {speciesLabel(id)}
                    </option>
                  ))}
                </select>
              </label>

              <label className="flex items-center gap-3">
                <span className="w-14 shrink-0 text-sm font-bold text-zinc-300">
                  Form
                </span>
                <select
                  className={field}
                  value={recordName}
                  onChange={(event) => setRecordName(event.target.value)}
                  disabled={!pokemonId}
                >
                  {!pokemonId && (
                    <option value="">Select Pokémon first</option>
                  )}
                  {formOptions.map((record) => (
                    <option key={record.name} value={record.name}>
                      {formLabel(record)}
                    </option>
                  ))}
                </select>
              </label>
            </div>

            <div className="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
              <label>
                <span className={label}>CP</span>
                <input
                  className={`mt-2 ${field}`}
                  inputMode="numeric"
                  value={cp}
                  onChange={(event) => setCp(event.target.value)}
                  placeholder="CP"
                />
              </label>

              <label>
                <span className={label}>Attack</span>
                <input
                  className={`mt-2 ${field}`}
                  type="number"
                  min="0"
                  max="15"
                  value={attack}
                  onChange={(event) => setAttack(event.target.value)}
                />
              </label>

              <label>
                <span className={label}>Defense</span>
                <input
                  className={`mt-2 ${field}`}
                  type="number"
                  min="0"
                  max="15"
                  value={defense}
                  onChange={(event) => setDefense(event.target.value)}
                />
              </label>

              <label>
                <span className={label}>HP</span>
                <input
                  className={`mt-2 ${field}`}
                  type="number"
                  min="0"
                  max="15"
                  value={hp}
                  onChange={(event) => setHp(event.target.value)}
                />
              </label>
            </div>

            <div className="mt-4 grid gap-3 sm:grid-cols-2">
              <label>
                <span className={label}>Height</span>
                <div className="relative mt-2">
                  <input
                    className={`${field} pr-12`}
                    inputMode="decimal"
                    value={height}
                    onChange={(event) => setHeight(event.target.value)}
                    placeholder="0.00"
                  />
                  <span className="absolute bottom-3 right-3 text-sm text-zinc-500">
                    m
                  </span>
                </div>
              </label>

              <label>
                <span className={label}>Weight</span>
                <div className="relative mt-2">
                  <input
                    className={`${field} pr-12`}
                    inputMode="decimal"
                    value={weight}
                    onChange={(event) => setWeight(event.target.value)}
                    placeholder="0.00"
                  />
                  <span className="absolute bottom-3 right-3 text-sm text-zinc-500">
                    kg
                  </span>
                </div>
              </label>
            </div>

            <h4 className="mt-5 text-sm font-black uppercase tracking-[0.18em] text-cyan-300">
              Moves
            </h4>

            {selectedMovePool ? (
              <div className="mt-3 grid gap-3 lg:grid-cols-3">
                <label>
                  <span className={label}>Fast Move</span>
                  <select
                    className={`mt-2 ${field}`}
                    value={fastMove}
                    onChange={(event) => setFastMove(event.target.value)}
                  >
                    {selectedMovePool.fastMoves.map((move) => (
                      <option key={move.id} value={move.id}>
                        {move.name}
                        {move.legacy ? " ★ Legacy" : ""}
                      </option>
                    ))}
                  </select>
                </label>

                <label>
                  <span className={label}>Charged Move 1</span>
                  <select
                    className={`mt-2 ${field}`}
                    value={chargedMove1}
                    onChange={(event) => setChargedMove1(event.target.value)}
                  >
                    {selectedMovePool.chargedMoves.map((move) => (
                      <option key={move.id} value={move.id}>
                        {move.name}
                        {move.legacy ? " ★ Legacy" : ""}
                      </option>
                    ))}
                  </select>
                </label>

                <label>
                  <span className={label}>Charged Move 2</span>
                  <select
                    className={`mt-2 ${field}`}
                    value={chargedMove2}
                    onChange={(event) => setChargedMove2(event.target.value)}
                  >
                    <option value="">None / Not unlocked</option>
                    {selectedMovePool.chargedMoves
                      .filter((move) => move.id !== chargedMove1)
                      .map((move) => (
                        <option key={move.id} value={move.id}>
                          {move.name}
                          {move.legacy ? " ★ Legacy" : ""}
                        </option>
                      ))}
                  </select>
                </label>
              </div>
            ) : (
              <div className="mt-3 rounded-xl border border-amber-900/70 bg-amber-950/20 px-4 py-3 text-sm text-amber-200">
                {selectedRecord
                  ? "No form-specific move pool is available for this WAR record yet."
                  : "Select a Pokémon and form to load its moves."}
              </div>
            )}

            <div className="mt-5 grid gap-4 lg:grid-cols-[0.55fr_1.45fr] lg:items-end">
              <div>
                <span className={label}>Special</span>
                <button
                  type="button"
                  aria-pressed={isShiny}
                  onClick={() => setIsShiny((current) => !current)}
                  className={`mt-2 w-full rounded-xl border px-4 py-3 text-sm font-bold transition ${
                    isShiny
                      ? "border-yellow-300 bg-yellow-400/15 text-yellow-200 shadow-sm shadow-yellow-950/50"
                      : "border-zinc-700 bg-zinc-900 text-zinc-400 hover:border-yellow-500 hover:text-yellow-200"
                  }`}
                >
                  {isShiny ? "✨ Shiny" : "☆ Shiny"}
                </button>
              </div>

              <div>
                <span className={label}>Max Capability</span>
                <div className="mt-2 grid grid-cols-3 gap-2">
                  {["Standard", "Dynamax", "Gigantamax"].map((type) => (
                    <button
                      key={type}
                      type="button"
                      onClick={() => setMaxType(type)}
                      className={`rounded-xl border px-3 py-3 text-sm font-bold transition ${
                        maxType === type
                          ? "border-cyan-400 bg-cyan-400/15 text-cyan-200"
                          : "border-zinc-700 bg-zinc-900 text-zinc-400 hover:border-zinc-500"
                      }`}
                    >
                      {type}
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <section className="mt-6 rounded-3xl border border-cyan-900/70 bg-gradient-to-r from-cyan-950/30 to-zinc-900 p-6">
            <p className="text-center text-xs font-bold uppercase tracking-[0.3em] text-cyan-400">
              Dr. Fair&apos;s Assessment
            </p>
            <h3 className="mt-2 text-center text-3xl font-black">
              {selectedRecord?.displayName ?? "Awaiting Specimen"}
            </h3>

            <div className="mt-5 grid gap-4 sm:grid-cols-3">
            <AssessmentTile
  label="PSV Value"
  value={
    selectedRecord?.psv !== undefined
      ? Number(selectedRecord.psv).toFixed(2)
      : "--.-"
  }
  note="WAR PSV"
  color="text-cyan-300"
/>
              <AssessmentTile
                label="Level"
                value={detectedLevelText}
                note={detectedLevels.length > 1 ? "Multiple matches" : "Auto-detected"}
                color="text-white"
              />
              <AssessmentTile
                label="Specimen Value"
                value={specimenValueText}
                note={pvpIvResult ? `${pvpIvResult.quality} PvP fit` : "Optimal potential"}
                color="text-emerald-300"
              />
            </div>
          </section>

          <section className="mt-6 rounded-3xl border border-zinc-800 bg-zinc-900/60 p-6">
            <p className="text-xs font-bold uppercase tracking-[0.25em] text-amber-400">
              Pokémon Value
            </p>
            <h3 className="mt-2 text-3xl font-black">Meta Value</h3>

            <div className="mt-6 grid gap-4 lg:grid-cols-3">
              <div className="rounded-2xl border border-red-900/60 bg-red-950/10 p-5">
                <h4 className="text-xl font-black text-red-300">Raid Meta</h4>
                {selectedRecord && raidMeta ? (
                  <div className="mt-4 space-y-3 text-sm text-white">
                    <RaidResultRow
                      label="Overall WAR Rank"
                      value={`#${selectedRecord.overallRank ?? "—"}`}
                    />
                    <RaidResultRow
                      label="Best Raid Matchup"
                      value={raidMeta.group.type}
                    />
                    <RaidResultRow
                      label={`${raidMeta.group.type} Rank`}
                      value={`#${raidMeta.entry.raidRank}`}
                    />
                    <RaidResultRow
                      label="Raid PSV"
                      value={(selectedRecord.psv ?? 0).toFixed(2)}
                    />
                    <RaidResultRow
                      label="Type Potential"
                      value={raidMeta.typePotential.toFixed(1) + "% of leader"}
                    />
                    <RaidResultRow
                      label="Ideal Raid Build"
                      value={`${moveLabel(raidMeta.entry.bestFastMove)} • ${moveLabel(raidMeta.entry.bestChargedMove)}`}
                      stacked
                    />
                    <div
                      className={`rounded-xl border px-3 py-2 font-bold ${
                        selectedRaidBuildMatches
                          ? "border-emerald-800 bg-emerald-950/30 text-emerald-300"
                          : "border-amber-900 bg-amber-950/20 text-amber-300"
                      }`}
                    >
                      {selectedRaidBuildMatches
                        ? "Selected build matches the ideal Raid build."
                        : "Selected build does not match the ideal Raid build."}
                    </div>
                  </div>
                ) : (
                  <p className="mt-4 text-sm text-zinc-500">
                    {selectedRecord
                      ? "No Raid type analysis was found for this form."
                      : "Select a Pokémon and form."}
                  </p>
                )}
              </div>
              <div className="rounded-2xl border border-blue-900/60 bg-blue-950/10 p-5">
                <h4 className="text-xl font-black text-blue-300">PvP Meta</h4>
                {pvpMeta && pvpIvResult ? (
                  <div className="mt-4 space-y-3 text-sm text-white">
                    <ResultRow label="Recommended League" value={leagueLabels[pvpMeta.league]} />
                    <ResultRow label="Meta Rank" value={`#${pvpMeta.rank} • Score ${pvpMeta.entry.score.toFixed(1)}`} />
                    <ResultRow label="Your IV Rank" value={`#${pvpIvResult.current.rank} of ${pvpIvResult.count.toLocaleString()}`} />
                    <ResultRow label="Optimal Potential" value={pvpIvResult.current.statProductPercent.toFixed(2) + "%"} />
                    <ResultRow label="Quality" value={pvpIvResult.quality} />
                    <ResultRow label="Ideal PvP IVs" value={`${pvpIvResult.best.atkIV} / ${pvpIvResult.best.defIV} / ${pvpIvResult.best.hpIV}`} />
                    <ResultRow label="Ideal PvP Build" value={pvpMeta.entry.moveset.map(moveLabel).join(" • ")} stacked />
                  </div>
                ) : (
                  <p className="mt-4 text-sm text-zinc-500">
                    {selectedRecord ? "No matching PvP ranking was found for this form." : "Select a Pokémon and form."}
                  </p>
                )}
              </div>
              <div className="rounded-2xl border border-purple-900/60 bg-purple-950/10 p-5">
                <h4 className="text-xl font-black text-purple-300">Max Battle</h4>
                {selectedRecord && maxBattleMeta ? (
                  <div className="mt-4 space-y-3 text-sm text-white">
                    <MaxResultRow label="Status" value={maxBattleMeta.role.identity} />
                    <MaxResultRow label="Best Role" value={maxBattleMeta.bestRole} />
                    <MaxResultRow label="Attacker" value={maxBattleMeta.role.attackerTier ?? "Not rated"} />
                    <MaxResultRow label="Tank" value={maxBattleMeta.role.defenderTier ?? "Not rated"} />
                    <MaxResultRow label="Healer" value={maxBattleMeta.role.healerTier ?? "Not rated"} />
                    {maxBattleMeta.role.defenderFastMoves?.length ? (
                      <MaxResultRow
                        label="Tank Fast Move"
                        value={maxBattleMeta.role.defenderFastMoves.join(" • ")}
                        stacked
                      />
                    ) : null}
                    <MaxResultRow
                      label="Recommended Max Attack"
                      value={maxBattleMeta.recommendedAttack}
                      stacked
                    />
                    {maxBattleMeta.selectedFastMoveName ? (
                      <p className="rounded-xl border border-purple-900/70 bg-black/20 px-3 py-2 text-xs text-purple-200">
                        Based on selected Fast Move: {maxBattleMeta.selectedFastMoveName}
                      </p>
                    ) : null}
                  </div>
                ) : (
                  <p className="mt-4 text-sm text-zinc-500">
                    {selectedRecord
                      ? maxType === "Standard"
                        ? "Select Dynamax or Gigantamax to evaluate Max Battle value."
                        : `No ${maxType} Max Battle role data is captured for this Pokémon.`
                      : "Select a Pokémon and form."}
                  </p>
                )}
              </div>
            </div>
          </section>

          <section className="mt-6 rounded-3xl border border-lime-900/60 bg-zinc-900/60 p-6">
            <p className="text-xs font-bold uppercase tracking-[0.25em] text-lime-400">
              Size &amp; Showcase Value
            </p>

            {selectedRecord && sizeShowcase ? (
              <div className="mt-5 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
                <div className="relative aspect-square min-h-[360px] overflow-hidden rounded-2xl border border-lime-900/50 bg-gradient-to-b from-zinc-950 to-black">
                  {[
                    { p: 99, size: 94 },
                    { p: 95, size: 82 },
                    { p: 90, size: 70 },
                    { p: 75, size: 56 },
                    { p: 50, size: 42 },
                  ].map((ring) => (
                    <div
                      key={ring.p}
                      className="absolute bottom-[7%] left-1/2 -translate-x-1/2 rounded-t-full border border-dashed border-lime-400/40"
                      style={{ width: ring.size + "%", height: ring.size + "%" }}
                    >
                      <span className="absolute left-1/2 top-1 -translate-x-1/2 whitespace-nowrap rounded bg-black/70 px-2 py-0.5 text-[10px] font-bold text-lime-300">
                        Larger than {ring.p}%
                      </span>
                    </div>
                  ))}

                  {sizeShowcase.artworkUrl ? (
                    <img
                      src={sizeShowcase.artworkUrl}
                      alt={selectedRecord.displayName}
                      className="absolute bottom-[5%] left-1/2 z-10 -translate-x-1/2 object-contain transition-all duration-300"
                      style={{
                        width: sizeShowcase.scale + "%",
                        height: sizeShowcase.scale + "%",
                      }}
                    />
                  ) : null}

                  <div className="absolute bottom-2 left-1/2 z-20 -translate-x-1/2 rounded-full border border-lime-800 bg-black/80 px-4 py-2 text-center">
                    <div className="text-xs text-zinc-400">Estimated size standing</div>
                    <div className="text-lg font-black text-lime-300">
                      {sizeShowcase.heightPercentile !== null
                        ? `Larger than ${sizeShowcase.heightPercentile.toFixed(1)}%`
                        : "Enter height"}
                    </div>
                  </div>
                </div>

                <div className="space-y-4">
                  <SizeResultCard
                    label="Height Standing"
                    value={sizeShowcase.heightPercentile !== null
                      ? `Larger than ${sizeShowcase.heightPercentile.toFixed(1)}%`
                      : "Enter height"}
                    note={`Species average: ${sizeShowcase.reference.averageHeightM} m`}
                  />
                  <SizeResultCard
                    label="Weight Standing"
                    value={sizeShowcase.weightPercentile !== null
                      ? `Heavier than ${sizeShowcase.weightPercentile.toFixed(1)}%`
                      : "Enter weight"}
                    note={`Species average: ${sizeShowcase.reference.averageWeightKg} kg`}
                  />
                  <SizeResultCard
                    label="Showcase Potential"
                    value={sizeShowcase.showcasePotential !== null
                      ? sizeShowcase.showcasePotential.toFixed(1) + "%"
                      : "Enter height and weight"}
                    note="Estimated blend: height 80%, weight 15%, IVs 5%"
                  />
                  <p className="text-xs leading-5 text-zinc-500">
                    Estimated from species averages and standard deviations. In-game values are rounded, and official Showcase scoring can include class-specific bonuses.
                  </p>
                </div>
              </div>
            ) : (
              <p className="mt-5 text-sm text-zinc-500">
                Select a Pokémon with available size-reference data.
              </p>
            )}
          </section>

          <section className="mt-6 rounded-3xl border-2 border-cyan-800 bg-gradient-to-r from-cyan-950/40 to-zinc-900 p-7 text-center">
            <p className="text-xs font-bold uppercase tracking-[0.3em] text-cyan-400">
              Dr. Fair&apos;s Recommendation
            </p>
            <h3 className="mt-3 text-4xl font-black">Awaiting Analysis</h3>
            <p className="mx-auto mt-3 max-w-3xl text-zinc-400">
              Keep / invest guidance will appear here after specimen, Raid,
              PvP, Max Battle, and size value are evaluated.
            </p>
          </section>
        </div>
      </section>
    </main>
  );
}

function SizeResultCard({
  label,
  value,
  note,
}: {
  label: string;
  value: string;
  note: string;
}) {
  return (
    <div className="rounded-2xl border border-zinc-800 bg-black/20 p-5">
      <div className="text-sm font-bold text-zinc-400">{label}</div>
      <div className="mt-2 text-2xl font-black text-lime-300">{value}</div>
      <div className="mt-1 text-xs text-zinc-600">{note}</div>
    </div>
  );
}

function AssessmentTile({
  label,
  value,
  note,
  color,
}: {
  label: string;
  value: string;
  note?: string;
  color: string;
}) {
  return (
    <div className="rounded-2xl bg-black/20 p-5 text-center">
      <div className="text-xs font-bold uppercase tracking-widest text-zinc-500">
        {label}
      </div>
      <div className={`mt-2 text-4xl font-black ${color}`}>{value}</div>
      {note && <div className="mt-1 text-xs text-zinc-600">{note}</div>}
    </div>
  );
}

function MaxResultRow({
  label,
  value,
  stacked = false,
}: {
  label: string;
  value: string;
  stacked?: boolean;
}) {
  return (
    <div className={stacked ? "space-y-1" : "flex justify-between gap-4"}>
      <span className="text-zinc-300">{label}</span>
      <span
        className={
          stacked
            ? "block font-bold text-purple-100"
            : "text-right font-bold text-purple-100"
        }
      >
        {value}
      </span>
    </div>
  );
}

function RaidResultRow({
  label,
  value,
  stacked = false,
}: {
  label: string;
  value: string;
  stacked?: boolean;
}) {
  return (
    <div className={stacked ? "space-y-1" : "flex justify-between gap-4"}>
      <span className="text-zinc-300">{label}</span>
      <span
        className={
          stacked
            ? "block font-bold text-red-100"
            : "text-right font-bold text-red-100"
        }
      >
        {value}
      </span>
    </div>
  );
}

function ResultRow({
  label,
  value,
  stacked = false,
}: {
  label: string;
  value: string;
  stacked?: boolean;
}) {
  return (
    <div className={stacked ? "space-y-1" : "flex justify-between gap-4"}>
      <span className="text-zinc-300">{label}</span>
      <span className={stacked ? "block font-bold text-blue-100" : "text-right font-bold text-blue-100"}>
        {value}
      </span>
    </div>
  );
}

function MetaCard({
  title,
  color,
  rows,
}: {
  title: string;
  color: "red" | "blue" | "purple";
  rows: string[];
}) {
  const styles = {
    red: "border-red-900/60 bg-red-950/10 text-red-300",
    blue: "border-blue-900/60 bg-blue-950/10 text-blue-300",
    purple: "border-purple-900/60 bg-purple-950/10 text-purple-300",
  };

  return (
    <div className={`rounded-2xl border p-5 ${styles[color]}`}>
      <h4 className="text-xl font-black">{title}</h4>
      <div className="mt-4 space-y-3 text-sm text-white">
        {rows.map((row) => (
          <div key={row} className="flex justify-between gap-4">
            <span>{row}</span>
            {pending}
          </div>
        ))}
      </div>
    </div>
  );
}
