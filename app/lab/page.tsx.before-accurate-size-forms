  ultra: ultraLeagueData as PvpEntry[],
  master: masterLeagueData as PvpEntry[],
};
function normalCdf(z: number) {
  const sign = z < 0 ? -1 : 1;
  const x = Math.abs(z) / Math.sqrt(2);
  const t = 1 / (1 + 0.3275911 * x);
  const erf = 1 -
    (((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t -
      0.284496736) * t + 0.254829592) * t) *
      Math.exp(-x * x);
  return 0.5 * (1 + sign * erf);
}

function percentileScale(percentile: number) {
  const stops = [
    [0, 28], [50, 42], [75, 55], [90, 68], [95, 78], [99, 90], [100, 96],
  ];
  for (let i = 1; i < stops.length; i += 1) {
    const [p1, s1] = stops[i - 1];
    const [p2, s2] = stops[i];
    if (percentile <= p2) {
      const ratio = (percentile - p1) / (p2 - p1);
      return s1 + ratio * (s2 - s1);
    }
  }
  return 96;
}

